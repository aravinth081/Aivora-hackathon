{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/admin", "dest": "/control.html" },
    { "src": "/control", "dest": "/control.html" },
    { "src": "/winner", "dest": "/winner.html" },
    { "src": "/judges", "dest": "/judges.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
